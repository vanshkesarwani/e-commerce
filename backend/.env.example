# Server Port
PORT=3900

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ecommerce?retryWrites=true&w=majority

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_KEY=your_cloudinary_secret_key

# JWT Secret & Expiry
JWT_SECRET_KEY=your_super_secret_jwt_key_here_minimum_32_chars
JWT_EXPIRE=30d
COOKIE_EXPIRE=30

# Frontend URL (For CORS & Cookie Credentials)
FRONTEND_URL=https://your-frontend-domain.com

# SMTP Email Configuration (Optional - for live password reset emails)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
